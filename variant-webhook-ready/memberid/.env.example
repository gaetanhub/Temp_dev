TELEGRAM_TOKEN=<token du bot>
TELEGRAM_BOT_USERNAME=<username du bot, sans @>
TELEGRAM_WEBHOOK_SECRET=<secret token>
TELEGRAM_POLLING_ENABLED=true   # passer à false en prod

# Migration vers webhook en prod :
# 1. Déployer avec URL publique HTTPS
# 2. POST https://api.telegram.org/bot{TELEGRAM_TOKEN}/setWebhook?url=https://<domaine>/api/telegram/webhook
# 3. Passer TELEGRAM_POLLING_ENABLED=false
# 4. Redémarrer
